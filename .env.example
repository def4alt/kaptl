# YNAB Bot — Configuration
# Copy to .env and fill in your values

# Required: Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Required: Your Telegram user ID (get from @userinfobot)
ALLOWED_TELEGRAM_ID=

# PostgreSQL connection
DATABASE_URL=postgres://ynab:ynab@localhost:5432/ynab?sslmode=disable

# Or set individually:
# DB_USER=ynab
# DB_PASSWORD=ynab
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ynab
